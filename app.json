{
  "expo": {
    "name": "ShilpSetu AI",
    "slug": "shilpsetu-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "shilpsetu",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shilpsetu.app",
      "infoPlist": {
        "NSCameraUsageDescription": "ShilpSetu needs camera access to photograph your craft products.",
        "NSMicrophoneUsageDescription": "ShilpSetu needs microphone access for voice-based product description.",
        "NSPhotoLibraryUsageDescription": "ShilpSetu needs photo library access to select product images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFF8F6"
      },
      "package": "com.shilpsetu.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "./scripts/withCpp20",
      "./scripts/withAndroidSigning",
      "./scripts/withGlobalExt",
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFF8F6"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ShilpSetu to access your camera to photograph products."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ShilpSetu to access your photos for product listings."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
