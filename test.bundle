a1f56a55c?w=600'],quantity:40},{...n,id:'product-004',name:'Handloom Dhurrie Rug',category:'Floor Coverings',material:'Cotton',price:2200,status:'draft',images:['https://images.unsplash.com/photo-1567016432779-094069958ea5?w=600'],quantity:5}],p=[...h,{...n,id:'disc-001',name:'Blue Pottery Vase',artisanId:'artisan-002',category:'Pottery',material:'Clay',price:1200,images:['https://images.unsplash.com/photo-1565193566173-7a0ee3dbe261?w=600'],origin:'Jaipur, Rajasthan'},{...n,id:'disc-002',name:'Warli Art Wall Panel',artisanId:'artisan-003',category:'Wall Art',material:'Wood',price:5500,images:['https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=600'],origin:'Thane, Maharashtra'},{...n,id:'disc-003',name:'Pashmina Stole',artisanId:'artisan-004',category:'Textiles',material:'Pashmina',price:8500,images:['https://images.unsplash.com/photo-1610030469983-98e550d6193c?w=600'],origin:'Srinagar, J&K'}],y=[s,{...s,id:'request-002',buyerId:'buyer-002',buyerName:'Craftopia Exports',buyerLocation:'Mumbai',title:'Handloom Sarees \u2014 Export Order',category:'Textiles',productType:'Handloom Sarees',quantity:200,budgetMin:2e3,budgetMax:4e3,budgetLabel:'\u20b92,000\u2013\u20b94,000 / unit',deadline:'2024-10-15',deadlineLabel:'15 October 2024',matchScore:81},{...s,id:'request-003',buyerId:'buyer-003',buyerName:'Organic Home Co.',buyerLocation:'Bengaluru',title:'Eco-friendly Gift Hampers',category:'Home Decor',productType:'Mixed Craft Items',quantity:150,budgetMin:800,budgetMax:1500,budgetLabel:'\u20b9800\u2013\u20b91,500 / set',deadline:'2024-09-10',deadlineLabel:'10 September 2024',matchScore:76}],f=[{id:'msg-001',threadId:'thread-001',senderId:'buyer-001',senderName:'Rahul (Heritage Living)',text:'Hello Sita ji! We love your bamboo basket samples. Can we discuss a bulk order of 500 units?',timestamp:'2024-08-15T10:00:00Z',isMe:!1},{id:'msg-002',threadId:'thread-001',senderId:'artisan-001',senderName:'Sita Devi',text:'Namaste! Yes, absolutely. I can accommodate 500 units. 